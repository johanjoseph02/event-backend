# Copy to .env (never commit it) or set these in your host's dashboard.
DATABASE_URL=postgres://user:password@localhost:5432/events
PORT=3000
BASE_URL=https://events.example.org
# 32+ random characters, e.g. `openssl rand -base64 48`. Rotating it invalidates every
# ticket and link already sent, and the stored ticket signing keys with them.
APP_SECRET=
EMAIL_TRANSPORT=file        # file | ses
EMAIL_FROM=Events <events@example.org>
AWS_REGION=ap-south-1       # for SES; credentials come from the usual AWS chain
TRUST_PROXY=false           # true behind a load balancer, so rate limits see client IPs
REGISTRATION_RATE_PER_MIN=10
RUN_WORKER=true             # false if you run `npm run worker` separately

{
  "name": "event-backend",
  "version": "2.0.0",
  "description": "Registration, waitlists, RSVP reminders and offline-capable QR check-in for community events.",
  "author": "Johan Mathew Joseph <johanmathewjoseph@gmail.com>",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "worker": "node src/worker.ts",
    "migrate": "node src/cli.ts migrate",
    "cli": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench:race": "node scripts/race.ts",
    "check": "npm run typecheck && npm test",
    "demo": "node scripts/demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1158.0",
    "express": "^5.3.0",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
